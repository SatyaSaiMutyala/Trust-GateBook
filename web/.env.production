# Production build (`npm run build`): the live Gatebook server. The web app and the API share this domain;
# Apache serves the built files and proxies /api and /socket.io to the API.
# Local development (`npm run dev`) does not read this file: it proxies to API_PROXY_TARGET (see .env.example).
VITE_API_URL=https://gatebook.mytrustlab.co.in
