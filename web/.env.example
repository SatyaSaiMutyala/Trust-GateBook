# API origin used by the browser. Leave empty in development: the Vite dev server proxies
# /api and /socket.io to API_PROXY_TARGET. Set it when the web app and API live on different
# origins, e.g. VITE_API_URL=https://gatebook-api.example.com
VITE_API_URL=

# Dev/preview proxy target for /api and /socket.io (read by vite.config.js, not shipped to the browser).
API_PROXY_TARGET=http://localhost:4000
