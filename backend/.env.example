# HTTP port for the API and Socket.IO
# Interface to listen on (default: 127.0.0.1 in production — nginx proxies to it; all interfaces in development)
# HOST=127.0.0.1
PORT=4000

# MongoDB connection string. Leave empty in development to use the embedded
# dev database (mongodb-memory-server, persisted in backend/.data/mongo).
MONGODB_URI=

# Secrets: set long random values in production.
JWT_SECRET=change-me-jwt-secret
FILE_URL_SECRET=change-me-file-url-secret

# Comma-separated list of allowed browser origins, or * for any.
# When unset: any origin in development; in production http://localhost:5173 and Expo dev (8081, 19006).
CORS_ORIGIN=

# Admin created on first start when there are no users
ADMIN_EMAIL=admin@gatebook.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# Where uploaded photos are stored (relative to backend/)
UPLOAD_DIR=uploads

# Time zone used for CSV dates, pass numbers and guard-facing messages
TZ_DISPLAY=Asia/Kolkata

# Port of the embedded dev MongoDB (only used when MONGODB_URI is empty)
EMBEDDED_MONGO_PORT=27018

NODE_ENV=development

# Post receivers come from Gatebook's own users who can receive post (Employee role, or "Can also
# receive post" ticked in Users). Optional, OFF by default: set this to use the Pace HR directory instead,
# e.g. PACE_EMPLOYEES_URL=https://pace.mytrustlab.co.in/api/v1/employees
PACE_EMPLOYEES_URL=

# Firebase Admin service account JSON for push notifications (FCM), relative to backend/.
# Missing file = push disabled (logged once at start-up); everything else keeps working. Never commit it.
FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json

# Web push (browser alerts). Optional: without these a key pair is made once and kept in the database.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Feature switches (default false). Apps read them from GET /api/config.
# SIGNUP_ENABLED: "Create an account" on the login screen; new accounts wait for admin approval.
# ACCOUNT_DELETION_ENABLED: "Delete account" in Account / My account. It is forced ON whenever sign-up is on
# (Apple App Store guideline 5.1.1(v): apps that allow account creation must allow in-app account deletion).
# SIGNUP_ENABLED=false
# ACCOUNT_DELETION_ENABLED=false

# Photo storage: local (default; files in UPLOAD_DIR served by /api/files) or s3 (private bucket, pre-signed URLs).
# STORAGE=s3 without AWS_BUCKET / region stops the server at start-up with a clear message.
# STORAGE=local
# AWS_BUCKET=trustlab-gatebook
# AWS_DEFAULT_REGION=ap-south-1
# AWS_S3_PREFIX=gatebook/
# Credentials: prefer an EC2 instance role (nothing to set here). Only if you can't, set
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in the server's real .env — never commit them.
# Testing / S3-compatible endpoints only:
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
