# HTTP port for the API and Socket.IO
PORT=4000

# MongoDB connection string. Leave empty in development to use the embedded
# dev database (mongodb-memory-server, persisted in backend/.data/mongo).
MONGODB_URI=

# Secrets: set long random values in production.
JWT_SECRET=change-me-jwt-secret
FILE_URL_SECRET=change-me-file-url-secret

# Comma-separated list of allowed browser origins, or * for any.
# When unset: any origin in development; in production http://localhost:5173 and Expo dev (8081, 19006).
CORS_ORIGIN=

# Admin created on first start when there are no users
ADMIN_EMAIL=admin@gatebook.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# Where uploaded photos are stored (relative to backend/)
UPLOAD_DIR=uploads

# Time zone used for CSV dates, pass numbers and guard-facing messages
TZ_DISPLAY=Asia/Kolkata

# Port of the embedded dev MongoDB (only used when MONGODB_URI is empty)
EMBEDDED_MONGO_PORT=27018

NODE_ENV=development
